    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Aukkhor.Windows</AssemblyName>
    <ApplicationIcon>Aukkhor.ico</ApplicationIcon>
